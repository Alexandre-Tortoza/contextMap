{
  "schema_version": "0.1.0",
  "pipeline": {
    "preset": "canonical/1"
  },
  "inputs": {
    "sequence": "REPLACE-WITH-THE-SEQUENCE-ARTIFACT-ID"
  },
  "resources": {
    "device": "cuda",
    "providers": {
      "region_perception.discovery": "REPLACE_WITH_YOUR_LOADERS_MODULE:load_sam2",
      "semantic_interpretation.interpreter": "REPLACE_WITH_YOUR_LOADERS_MODULE:load_qwen"
    }
  },
  "policies": {
    "debug_level": "standard",
    "trajectory_mode": "allow_ground_truth"
  },
  "components": {
    "ingestion": {
      "source_adapter": {
        "backend": "ros1_bag"
      }
    },
    "state_estimation": {
      "estimator": {
        "backend": "external_pose",
        "external_pose": {
          "reference_frame": "map",
          "body_frame": "epson",
          "invalid_sample_policy": "skip"
        }
      }
    },
    "geometric_mapping": {
      "pose_lookup": {
        "backend": "lookup-policy-v1",
        "lookup-policy-v1": {
          "mode": "interpolated",
          "max_interpolation_gap_ns": 400000000
        }
      },
      "motion_correction": {
        "backend": "motion-correction-v1",
        "motion-correction-v1": {
          "raw": "accept",
          "unknown": "warn"
        }
      }
    },
    "sensor_association": {
      "occlusion": {
        "backend": "conservative-depth-support-v1",
        "conservative-depth-support-v1": {
          "cell_size_px": 4,
          "neighborhood_radius_cells": 2,
          "depth_margin_m": 0.1,
          "depth_margin_ratio": 0.02
        }
      },
      "tolerances": {
        "backend": "diagnostic-tolerances-v1",
        "diagnostic-tolerances-v1": {
          "max_pose_time_delta_ns": 250000000,
          "max_map_window_offset_ns": 1000000000,
          "max_reprojection_p95_px": null,
          "max_reprojection_invalid_rate": null
        }
      },
      "pose_policy": {
        "backend": "lookup-policy-v1",
        "lookup-policy-v1": {
          "mode": "interpolated",
          "max_interpolation_gap_ns": 450000000
        }
      }
    },
    "semantic_fusion": {
      "support": {
        "backend": "geometry-jaccard-support-v1",
        "geometry-jaccard-support-v1": {
          "min_geometry_count": 5,
          "min_overlap": 0.3
        }
      },
      "accumulation": {
        "backend": "baseline-evidence-accumulation-v1"
      }
    },
    "semantic_mapping": {
      "geometry_summary": {
        "backend": "entity-geometry-summary-v1",
        "entity-geometry-summary-v1": {
          "sparse_point_threshold": 3,
          "connectivity_radius_m": 0.5
        }
      }
    },
    "entity_resolution": {
      "retrieval": {
        "backend": "entity-candidate-retrieval-v1",
        "entity-candidate-retrieval-v1": {
          "centroid_radius_m": 20.0,
          "bounds_margin_m": 0.1
        }
      },
      "resolution": {
        "backend": "conservative-staged-resolution-v1",
        "conservative-staged-resolution-v1": {
          "use_channels": [
            "geometry"
          ],
          "min_supporting_channels": 1
        }
      },
      "geometry_comparison": {
        "backend": "entity-geometry-comparison-v1",
        "entity-geometry-comparison-v1": {
          "min_shared_support_jaccard": 0.5,
          "min_bounds_iou": 0.5,
          "min_bounds_containment": 0.9,
          "min_conflict_gap_m": 0.5,
          "min_extent_ratio": 0.3
        }
      }
    },
    "spatial_relations": {
      "frame_conventions": {
        "backend": "map-frame-conventions-v1",
        "map-frame-conventions-v1": {
          "map_frame": "map",
          "up_axis": "+z",
          "forward_axis": "+x"
        }
      },
      "candidate": {
        "backend": "bounds-neighborhood-candidates-v1",
        "bounds-neighborhood-candidates-v1": {
          "predicates": [
            "next_to",
            "touching"
          ],
          "proximity_radius_m": 0.6,
          "directional_radius_m": 2.0
        }
      },
      "geometry_summary": {
        "backend": "entity-geometry-summary-v1",
        "entity-geometry-summary-v1": {
          "sparse_point_threshold": 3,
          "connectivity_radius_m": 0.5
        }
      },
      "geometric_predicate": {
        "backend": "bounds-geometric-predicates-v1",
        "bounds-geometric-predicates-v1": {
          "boundary_tolerance_m": 0.02,
          "next_to_max_gap_m": 0.5,
          "adjacent_penetration_m": 0.05,
          "containment_slack_m": 0.05,
          "directional_overlap_fraction": 0.5
        }
      },
      "contact_predicate": {
        "backend": "point-contact-predicates-v1",
        "point-contact-predicates-v1": {
          "contact_distance_m": 0.05,
          "contact_tolerance_m": 0.02,
          "min_contact_points": 3,
          "support_height_tolerance_m": 0.05,
          "support_footprint_fraction": 0.5,
          "leaning_min_tilt_deg": 10.0,
          "leaning_max_tilt_deg": 80.0,
          "tilt_tolerance_deg": 2.0,
          "leaning_min_vertical_overlap_m": 0.3
        }
      }
    },
    "region_perception": {
      "discovery": {
        "backend": "sam2",
        "sam2": {
          "checkpoint": "REPLACE-WITH-THE-SAM2.1-HIERA-TINY-CHECKPOINT",
          "model_version": "REPLACE-WITH-THE-SAM2-MODEL-VERSION-OF-THE-V0.1.0-RUN",
          "device": "cuda"
        }
      }
    },
    "visual_features": {
      "dense": {
        "backend": "dinov2",
        "dinov2": {
          "checkpoint": "facebook/dinov2-base",
          "revision": "REPLACE-WITH-THE-DINOV2-REVISION",
          "device": "cuda"
        }
      },
      "region": {
        "backend": "clip",
        "clip": {
          "checkpoint": "openai/clip-vit-large-patch14",
          "revision": "REPLACE-WITH-THE-CLIP-REVISION",
          "device": "cuda"
        }
      }
    },
    "semantic_interpretation": {
      "interpreter": {
        "backend": "qwen",
        "qwen": {
          "model": "Qwen/Qwen3-VL-4B-Instruct",
          "quantization": "4bit",
          "temperature": 0.0,
          "device": "cuda",
          "precision": "REPLACE-WITH-THE-QWEN-PRECISION",
          "max_new_tokens": "REPLACE-WITH-THE-QWEN-TOKEN-BUDGET",
          "prompt_policy": {
            "scene": "scene/v1",
            "region": "region/v1"
          },
          "view_policy": {
            "region_views": [
              "tight_crop"
            ]
          }
        }
      }
    }
  }
}
